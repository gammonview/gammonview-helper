<?xml version="1.0" encoding="utf-8"?>
<!--
  Two lines in here are load-bearing.

  `asInvoker`: Windows guesses that an unmanifested program with "Installer" in
  its name wants to be an administrator, and raises a UAC prompt for it. This
  one installs into the user's own profile and must never ask — a UAC prompt
  from an unsigned program says "Unknown publisher" in yellow, which is the
  screen most likely to make somebody stop.

  `dpiAware`: without it Windows bitmap-stretches the window on any display
  scaled above 100%, which is most laptops, and the confirmation word — the one
  thing on screen somebody must read exactly — arrives blurred.
-->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="GammonView.Installer"/>
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true</dpiAware>
    </windowsSettings>
  </application>
  <dependency>
    <dependentAssembly>
      <assemblyIdentity type="win32" name="Microsoft.Windows.Common-Controls"
        version="6.0.0.0" processorArchitecture="*" publicKeyToken="6595b64144ccf1df" language="*" />
    </dependentAssembly>
  </dependency>
</assembly>
